<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/QmkToolbox.Core/QmkToolbox.Core.csproj" />
    <ProjectReference Include="../../src/QmkToolbox.Desktop/QmkToolbox.Desktop.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Fixture resources for FlashToolProviderExtractionTests, embedded under the production
         resource prefix so extraction runs against this assembly deterministically. -->
    <EmbeddedResource Include="Fixtures/flashutils_release_testhost" LogicalName="QmkToolbox.Desktop.Resources.flashutils_release_testhost" />
    <EmbeddedResource Include="Fixtures/hidapi_release_testhost" LogicalName="QmkToolbox.Desktop.Resources.hidapi_release_testhost" />
    <EmbeddedResource Include="Fixtures/avrdude" LogicalName="QmkToolbox.Desktop.Resources.avrdude" />
  </ItemGroup>
</Project>
