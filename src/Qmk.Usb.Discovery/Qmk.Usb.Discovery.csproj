<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Qmk.Usb.Discovery</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Package-bound: every public member ships XML docs, so re-enable CS1591 (suppressed repo-wide). -->
    <NoWarn>$(NoWarn.Replace(';CS1591', ''))</NoWarn>
    <Description>USB device hotplug detection for Windows, Linux, and macOS. Uses native OS notifications rather than polling, reports devices already present at startup, and delivers removal events that carry full device identity.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
