<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:QmkToolbox.Desktop.ViewModels"
        xmlns:conv="using:QmkToolbox.Desktop.Converters"
        x:Class="QmkToolbox.Desktop.Views.KeyTesterWindow"
        x:DataType="vm:KeyTesterViewModel"
        x:CompileBindings="True"
        Title="Key Tester"
        Width="1060" Height="380"
        CanResize="False">

    <Design.DataContext>
        <vm:KeyTesterViewModel />
    </Design.DataContext>

    <DockPanel>
        <!-- Status bar -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="8,4" Spacing="8">
            <TextBlock Text="Last key:" VerticalAlignment="Center" />
            <TextBlock Text="{Binding LastKeycode}" VerticalAlignment="Center" Width="160" />
            <TextBlock Text="Scan code:" VerticalAlignment="Center" />
            <TextBlock Text="{Binding LastScanCode}" VerticalAlignment="Center" Width="70" />
            <Button Content="Reset" Command="{Binding ResetCommand}" />
        </StackPanel>

        <!-- Key positions come from the ViewModel's layout table; KeyStateConverters map
             key state and theme variant to colours. -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Keys}" Width="1040" Height="278" Margin="8">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.Styles>
                    <Style Selector="ItemsControl > ContentPresenter" x:DataType="vm:KeyViewModel">
                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                    </Style>
                </ItemsControl.Styles>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:KeyViewModel">
                        <Border Width="{Binding Width}" Height="{Binding Height}"
                                BorderBrush="#808080" BorderThickness="1" CornerRadius="3">
                            <Border.Background>
                                <MultiBinding Converter="{x:Static conv:KeyStateConverters.Background}">
                                    <Binding Path="State" />
                                    <Binding Path="$parent[Window].ActualThemeVariant" />
                                </MultiBinding>
                            </Border.Background>
                            <TextBlock Text="{Binding Label}" FontSize="10" TextWrapping="Wrap"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Foreground>
                                    <MultiBinding Converter="{x:Static conv:KeyStateConverters.Foreground}">
                                        <Binding Path="State" />
                                        <Binding Path="$parent[Window].ActualThemeVariant" />
                                    </MultiBinding>
                                </TextBlock.Foreground>
                            </TextBlock>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
